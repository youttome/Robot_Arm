<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- =========================
         Basic Colors
    ========================== -->

    <material name="white">
        <color rgba="0.95 0.95 0.95 1.0"/>
    </material>

    <material name="black">
        <color rgba="0.02 0.02 0.02 1.0"/>
    </material>

    <material name="gray">
        <color rgba="0.45 0.45 0.45 1.0"/>
    </material>

    <material name="dark_gray">
        <color rgba="0.15 0.15 0.15 1.0"/>
    </material>

    <material name="silver">
        <color rgba="0.70 0.70 0.72 1.0"/>
    </material>

    <!-- =========================
         Main Robot Colors
    ========================== -->

    <material name="blue">
        <color rgba="0.05 0.25 0.80 1.0"/>
    </material>

    <material name="light_blue">
        <color rgba="0.10 0.55 1.00 1.0"/>
    </material>

    <material name="cyan">
        <color rgba="0.00 0.80 0.90 1.0"/>
    </material>

    <material name="red">
        <color rgba="0.85 0.03 0.03 1.0"/>
    </material>

    <material name="green">
        <color rgba="0.05 0.70 0.15 1.0"/>
    </material>

    <material name="yellow">
        <color rgba="1.00 0.80 0.00 1.0"/>
    </material>

    <material name="orange">
        <color rgba="1.00 0.35 0.02 1.0"/>
    </material>

    <!-- =========================
         Robot Parts
    ========================== -->

    <material name="body">
        <color rgba="0.12 0.25 0.45 1.0"/>
    </material>

    <material name="arm">
        <color rgba="0.18 0.18 0.20 1.0"/>
    </material>

    <material name="joint">
        <color rgba="0.65 0.67 0.70 1.0"/>
    </material>

    <material name="gripper">
        <color rgba="0.25 0.27 0.30 1.0"/>
    </material>

    <material name="rubber">
        <color rgba="0.03 0.03 0.03 1.0"/>
    </material>

</robot>